{"credit":"Traditional Swabian folk song, text by Heinrich Wagner (1824), first verse","song":{"slug":"muss-i-denn","engine":"model","lines":[{"time":null,"text":"Muss i denn, muss i denn zum Städtele hinaus,","tokens":[{"text":"Muss","lemma":"müssen","pos":"MOD","slot":2,"clause":0,"clauseType":"main","forms":["modal","present"],"gloss":"must"},{"text":"i","lemma":"ich","pos":"PRON","slot":3,"clause":0,"clauseType":"main","forms":[],"gloss":"I (dialect)"},{"text":"denn","lemma":"denn","pos":"CONN","slot":3,"clause":0,"clauseType":"main","forms":[],"gloss":"because / then"},{"text":"muss","lemma":"müssen","pos":"MOD","slot":2,"clause":1,"clauseType":"main","forms":["modal","present","separable"],"gloss":"must"},{"text":"i","lemma":"ich","pos":"PRON","slot":3,"clause":1,"clauseType":"main","forms":[],"gloss":"I (dialect)"},{"text":"denn","lemma":"denn","pos":"CONN","slot":3,"clause":1,"clauseType":"main","forms":[],"gloss":"because / then"},{"text":"zum","lemma":"zu","pos":"PREP","slot":3,"clause":1,"clauseType":"main","forms":["dat"],"gloss":"to the"},{"text":"Städtele","lemma":"städtele","pos":"N","slot":3,"clause":1,"clauseType":"main","forms":[],"gloss":"little town (dialect)"},{"text":"hinaus","lemma":"hinaus","pos":"ADV","slot":4,"clause":1,"clauseType":"main","forms":["separable"],"gloss":"out"}],"question":null,"translation":"Must I then, must I then leave the little town,"},{"time":null,"text":"Städtele hinaus, und du, mein Schatz, bleibst hier?","tokens":[{"text":"Städtele","lemma":"städtele","pos":"X","slot":1,"clause":0,"clauseType":"main","forms":[],"gloss":"little town (dialect)"},{"text":"hinaus","lemma":"hinaus","pos":"ADV","slot":1,"clause":0,"clauseType":"main","forms":[],"gloss":"out"},{"text":"und","lemma":"und","pos":"CONN","slot":0,"clause":1,"clauseType":"main","forms":[],"gloss":"and"},{"text":"du","lemma":"du","pos":"PRON","slot":3,"clause":1,"clauseType":"main","forms":[],"gloss":"you"},{"text":"mein","lemma":"mein","pos":"DET","slot":3,"cla